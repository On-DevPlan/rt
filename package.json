{
  "name": "rt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "backend": "cd backend && uv run uvicorn rt_backend.main:app --reload --port 8080",
    "tts": "pnpm backend",
    "dev": "vite --host 0.0.0.0 --port 81",
    "dev:all": "npx concurrently \"pnpm backend\" \"pnpm dev\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4181",
    "parse:algos": "python scripts/parse_algo.py",
    "parse:algos:watch": "python scripts/parse_algo.py --watch"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.4"
  }
}
