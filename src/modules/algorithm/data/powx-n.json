    {
      "id": 4,
      "title": "完成",
      "titleEn": "Complete",
      "code": "# 快速幂算法\n# 计算 x 的 n 次幂，实现 pow(x, n) 函数\n#\n# 关键约束:\n#   -100.0 < x < 100.0\n#   -2^31 <= n <= 2^31-1\n#   n 是整数（可能为负）\n#\n# 示例:\n#   x = 2.0, n = 10\n#   结果: 1024.0\n#\n#   x = 2.0, n = -2\n#   结果: 0.25 (即 1/4)\n\ndef myPow(x: float, n: int) -> float:\n    \"\"\"返回 x 的 n 次幂\"\"\"\n    if n == 0:\n        return 1.0\n    if n < 0:\n        return 1.0 / myPow(x, -n)\n    half = myPow(x, n // 2)\n    if n % 2 == 0:\n        return half * half\n    return half * half * x",
