      "titleEn": "Handle Boundaries",
      "code": "# 64. 最小路径和\n# 从左上角到右下角的最小路径和\n#\n# 问题描述:\n#   给定一个 m×n 的网格，每个格子有一个非负整数\n#   找出从左上角到右下角的路径，使路径上数字之和最小\n#   每次只能向右或向下移动\n#\n# 示例:\n#   grid = [[1,3,1],\n#           [1,5,1],\n#           [4,2,1]]\n#   最小路径和: 7 (1→3→1→1→1)\n\nfrom typing import List\n\ndef minPathSum(grid: List[List[int]]) -> int:\n    \"\"\"返回从左上角到右下角的最小路径和。\"\"\"\n    m, n = len(grid), len(grid[0])\n    for i in range(m):\n        for j in range(n):\n            if i == 0 and j == 0:\n                continue\n            elif i == 0:\n                grid[i][j] += grid[i][j - 1]\n            elif j == 0:\n                grid[i][j] += grid[i - 1][j]\n            else:\n                grid[i][j] += min(grid[i - 1][j], grid[i][j - 1])",
