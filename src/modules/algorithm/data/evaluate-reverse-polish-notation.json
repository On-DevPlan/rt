      "code": "# 逆波兰表达式求值\n# 给定一个字符串数组 tokens，表示逆波兰表达式（后缀表达式）\n# 求该表达式的值，并作为整数返回\n#\n# 运算符: + - * /，每个运算对象可以是整数或另一个表达式\n# 整数运算只保留整数部分，即「向 0 截断」\n#\n# 示例 1:\n#   tokens = [\"2\",\"1\",\"+\",\"3\",\"*\"]\n#   ((2 + 1) * 3) = 9\n#\n# 示例 2:\n#   tokens = [\"4\",\"13\",\"5\",\"/\",\"+\"]\n#   (4 + (13 / 5)) = 4 + 2 = 6\n\nfrom typing import List\n\ndef evalRPN(tokens: List[str]) -> int:\n    \"\"\"求逆波兰表达式的值。\"\"\"\n    ops = {'+', '-', '*', '/'}\n    stk = []\n    for t in tokens:\n        if t in ops:\n            b = stk.pop()  # 先弹出的 = 右操作数\n            a = stk.pop()  # 后弹出的 = 左操作数\n            if t == '+': c = a + b\n            elif t == '-': c = a - b\n            elif t == '*': c = a * b\n            else:\n                # 向 0 截断除法：符号相同时用 int(a/b)，否则取负\n                c = int(a / b) if a * b >= 0 else -int(-a / b)\n            stk.append(c)\n        else:\n            stk.append(int(t))",
