node_modules
dist
.DS_Store
.idea
.vscode
*.local

# Cloned repositories (nested git repos)
# 父目录必须用 /* 半透明模式，否则否定规则失效
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# .claude/www/git.remote 清单是仓库内容，随宿主提交（sl-git-standard）——
# 故意不写忽略规则：清单随仓库走，换机器/同事 clone 后 sync 才有输入

.playwright-mcp
.venv
*.db
__pycache__/
*.pyc
.pytest_cache/
# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/
.env